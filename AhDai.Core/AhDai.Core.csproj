<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<Version>1.10.35</Version>
		<AssemblyVersion>1.10.35</AssemblyVersion>
		<FileVersion>1.10.35</FileVersion>
		<Authors>Shuang Yu</Authors>
		<Company>AhDai</Company>
		<Copyright>© Shuang Yu. All rights reserved.</Copyright>

		<Description>常用方法封装 - Core</Description>
		<PackageIcon></PackageIcon>
		<PackageTags>AhDai;Core</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/doublefish/AhDai</PackageProjectUrl>
		<RepositoryUrl>https://github.com/doublefish/AhDai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Token加密方式升级为RSA</PackageReleaseNotes>

		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>AhDai.Core.xml</DocumentationFile>
		<OpenApiGenerateDocuments>False</OpenApiGenerateDocuments>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageReference Include="StackExchange.Redis" Version="3.4.35" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.34" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.34" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' ">
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
